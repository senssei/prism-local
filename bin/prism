#!/usr/bin/env bash
#
# prism: Next-Generation Multi-Engine Local AI CLI & Inference Server for Linux & WSL2
#
# Refracts disparate local runtimes (ONNX Runtime GenAI on NVIDIA CUDA, Ollama/llama.cpp GGUF)
# into a unified developer CLI, interactive terminal chat, benchmark suite, and OpenAI-compatible REST server.
#

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# Select Python environment with onnxruntime_genai installed
if [ -f "$SCRIPT_DIR/../02-ollama-loadtest/.venv/bin/python3" ]; then
    PYTHON="$SCRIPT_DIR/../02-ollama-loadtest/.venv/bin/python3"
elif [ -f "$SCRIPT_DIR/.venv/bin/python3" ]; then
    PYTHON="$SCRIPT_DIR/.venv/bin/python3"
else
    PYTHON="$(which python3)"
fi

export PYTHONPATH="$SCRIPT_DIR:${PYTHONPATH:-}"

exec "$PYTHON" -m prism.cli "$@"
