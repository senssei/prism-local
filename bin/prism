#!/usr/bin/env bash
#
# prism: Multi-engine local AI CLI & OpenAI-compatible server for Linux & WSL2
# (ONNX Runtime GenAI on NVIDIA CUDA, Ollama/llama.cpp GGUF).
#
# Python selection: $PRISM_PYTHON, then ./.venv in this checkout, then the active
# virtualenv, then python3 on PATH.
#

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

case "$(basename "$0")" in
    fng|foundry-ng)
        echo "note: '$(basename "$0")' is a deprecated alias; use 'prism'." >&2
        ;;
esac

if [ -n "${PRISM_PYTHON:-}" ]; then
    PYTHON="$PRISM_PYTHON"
elif [ -x "$SCRIPT_DIR/.venv/bin/python3" ]; then
    PYTHON="$SCRIPT_DIR/.venv/bin/python3"
elif [ -n "${VIRTUAL_ENV:-}" ] && [ -x "$VIRTUAL_ENV/bin/python3" ]; then
    PYTHON="$VIRTUAL_ENV/bin/python3"
else
    PYTHON="$(command -v python3)"
fi

export PYTHONPATH="$SCRIPT_DIR:${PYTHONPATH:-}"

exec "$PYTHON" -m prism.cli "$@"
