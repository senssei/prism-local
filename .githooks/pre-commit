#!/bin/sh
# Opt-in gate before every commit (any agent, any editor, or you). Enable once per clone:
#     git config core.hooksPath .githooks
# Disable with: git config --unset core.hooksPath
# It checks the working tree, not only what is staged. ~20 s; agents must not bypass it with --no-verify.
root=$(git rev-parse --show-toplevel) || exit 1
cd "$root" || exit 1
exec "${PYTHON:-python3}" scripts/sdlc_check.py --only compile --only tests --only changelog
